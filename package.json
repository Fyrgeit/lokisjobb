{
    "name": "lokisjobb",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx --env-file=.env src/index.ts",
        "jobs": "tsx --env-file=.env src/list-jobs.ts",
        "build": "tsc",
        "start": "node --env-file=.env dist/index.js",
        "test": "tsx --test \"src/**/*.test.ts\"",
        "lint": "eslint .",
        "server": "tsx --env-file=.env src/server.ts",
        "server:watch": "tsx watch --env-file=.env src/server.ts",
        "analyze": "tsx --env-file=.env src/analyze-providers.ts",
        "evaluate": "tsx --env-file=.env src/evaluate-jobs.ts"
    },
    "dependencies": {
        "better-sqlite3": "^12.4.1",
        "cheerio": "^1.1.2",
        "express": "^5.2.1"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/express": "^5.0.6",
        "@types/node": "^24.10.1",
        "@typescript-eslint/eslint-plugin": "^8.46.3",
        "@typescript-eslint/parser": "^8.46.3",
        "eslint": "^9.39.1",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.3"
    }
}
